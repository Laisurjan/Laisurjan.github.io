{
  "version": "115.10.29",
  "abilities": {
    "C1": {
      "name": "讓人站進別人的處境做選擇",
      "desc": "扮演一個不是自己的位置，選擇會有代價、結局會有回饋。"
    },
    "C2": {
      "name": "從熟悉的當下搭橋到陌生的文本",
      "desc": "用學生已經在意的事（留言、電玩、校園情境、奇幻設定）接到古文、制度或議題。"
    },
    "C3": {
      "name": "把看不見的原理做成能動手驗證的模型",
      "desc": "光學、投影、交通風險、結構性不平等——先預測、再操作、再看結果。"
    },
    "C4": {
      "name": "讓一群人即時看見彼此",
      "desc": "全班同時輸入，結果即時匯到投影或彼此的手機上。"
    },
    "C5": {
      "name": "把複雜任務拆成能反覆練的步驟",
      "desc": "閱讀、演說、應用文、訪價、AI 備課——拆成固定流程，練得起來、也量得出來。"
    },
    "C6": {
      "name": "從花蓮的真實場域與資料出發",
      "desc": "路網、事故點、淹水潛勢、校園噪音、在地超市、縱谷事件——素材是這裡的。"
    },
    "C7": {
      "name": "做出別人能直接接手使用的系統",
      "desc": "老師登入、開房、名單、成績、匯出——不是 demo，是別的老師明天就能用的東西。"
    },
    "C8": {
      "name": "把做法整理給別人複用",
      "desc": "講座、分享簡報、公開 repo 的課程設計與工具。"
    },
    "C9": {
      "name": "把文本與脈絡整理成看得見的結構",
      "desc": "歷史地圖、恩仇簿、制度演變、互動圖解、數位展覽。"
    }
  },
